# API keys are stored in the database via Settings and are never exposed to the
# browser. GROK_API_KEY here is an optional override that takes precedence.
GROK_API_KEY=

# Optional: set a password to protect the app. Leave blank for open access.
APP_PASSWORD=your_password_here

# Postgres connection used by server.js
DATABASE_URL=postgresql://blogengine:blogengine@localhost:5432/blogdb
DB_SSL=false

# Only set if the API is served from a different origin than the React build.
# CORS_ORIGIN=https://app.example.com
